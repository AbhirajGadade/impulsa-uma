{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EmpleaKit UMA: local development",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve.mjs",
      "args": ["--watch"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
